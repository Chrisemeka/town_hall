# Only the variables worth documenting live here. The rest are in .env.local.

# Rate limiting kill switch (lib/rateLimitDb.ts). Set to "true" to disable
# every rate limit — each check then passes and logs "[rate-limit] DISABLED".
# Unset, or any other value, means limits are ON. Use it when a limiter bug is
# stopping people working: change it in Vercel and redeploy the current build.
RATE_LIMIT_DISABLED=

# Cloudflare Turnstile site key — public by design, rendered into the auth
# forms (components/public/auth/Turnstile.tsx). The SECRET key is not an app
# variable: it lives only in Supabase → Auth → Attack Protection, which
# verifies the token. Do not add it here or to Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
